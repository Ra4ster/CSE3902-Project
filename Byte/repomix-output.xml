        EnemyDescription gelDesc = new EnemyDescription
        {
            Type = EnemyType.Gel,
            PatrolPath = [
                new Vector2(300, 800),
                new Vector2(800, 800)
            ],
            Speed = 200f,
            WaitDuration = 1.5f
        };

        EnemyDescription aquamentusDesc = new EnemyDescription
        {
            Type = EnemyType.Aquamentus,
            PatrolPath = [
                new Vector2(800, 900),
                new Vector2(1000, 900)
